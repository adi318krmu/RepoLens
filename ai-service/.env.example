# Environment Configuration for RepoLens AI Microservice
PORT=8000
ENVIRONMENT=development

# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Service-to-Service Security Key (Must match AI_SERVICE_API_KEY in Node.js backend)
AI_SERVICE_API_KEY=repolens_internal_secret_key_change_in_production
